# Copy to an ignored .env for local use, or inject variables in Northflank.
NODE_ENV=development
REDIS_URL=redis://127.0.0.1:6379
LIVEKIT_BOT_IDENTITY=lumos
LIVEKIT_URL=wss://<project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_STREAMING_URL=wss://streaming.assemblyai.com/v3/ws
SEMANTIC_PROVIDER=groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b
TTS_PROVIDER=edge
TTS_LANGUAGE=en-US
TTS_VOICE=en-US-AriaNeural
TTS_RATE=+0%
TTS_VOLUME=+0%
TTS_TIMEOUT=8s
TTS_MAX_RETRIES=2
REALTIME_PORT=8081
METRICS_BEARER_TOKEN=
# Production requires a token OR an explicitly private, non-public port.
# This flag does not enforce networking; configure Northflank private exposure.
METRICS_PRIVATE_ONLY=false
