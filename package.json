{
  "name": "lumos",
  "version": "0.1.0",
  "private": true,
  "description": "LUMOS AI - Outcome-driven realtime meeting intelligence",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check:docs": "node scripts/check-deployment-docs.mjs",
    "smoke:redis": "node scripts/redis-compatibility-smoke.mjs",
    "dev": "echo \"LUMOS development environment\"",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  }
}
