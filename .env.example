NODE_ENV=development

# Applications
# WEB_PORT is only a local convenience; Next uses --port or PORT.
WEB_PORT=3000
API_PORT=3001

# PostgreSQL
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

DATABASE_URL=
DATABASE_SSL_MODE=
DATABASE_SSL_CA_FILE=

# Redis
REDIS_URL=redis://localhost:6379

# Realtime Go service
REALTIME_PORT=8081
METRICS_BEARER_TOKEN=
METRICS_PRIVATE_ONLY=false

# LiveKit
LIVEKIT_BOT_IDENTITY=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# AssemblyAI
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_STREAMING_URL=

# Groq
SEMANTIC_PROVIDER=

GROQ_API_KEY=
GROQ_BASE_URL=
GROQ_MODEL=
GROQ_FALLBACK_MODEL=

WEB_ORIGIN=
API_PUBLIC_URL=
TRUSTED_PROXY_CIDRS=

NEXT_PUBLIC_API_URL=

ATLASSIAN_TOKEN_ENCRYPTION_KEY=
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
ATLASSIAN_REDIRECT_URI=

JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
AUTH_OTP_PEPPER=
AUTH_REFRESH_TTL_DAYS=30

AUTH_EMAIL_PROVIDER=console
AUTH_EMAIL_FROM=
RESEND_API_KEY=

# Optional one-time platform admin bootstrap. Omit these unless intentionally used.
# PLATFORM_ADMIN_BOOTSTRAP_EMAIL=admin@example.com
# PLATFORM_ADMIN_BOOTSTRAP_PASSWORD=<unique password at least 12 characters>
# PLATFORM_ADMIN_BOOTSTRAP_NAME=Platform Admin

# TTS defaults may be omitted
TTS_PROVIDER=edge
TTS_LANGUAGE=en-US
TTS_VOICE=en-US-AriaNeural
TTS_RATE=+0%
TTS_VOLUME=+0%
TTS_TIMEOUT=8s
TTS_MAX_RETRIES=2
